<?xml version="1.0"?>
<package format="3">
  <name>gn_supervisor</name>
  <version>0.1.0</version>
  <description>Supervisor of gn_loc: watches it, holds Nav2 when it cannot be trusted and relocalizes with a correlative search + GICP on the 3D prior of the map</description>
  <maintainer email="narcis.abellallos@gmail.com">Narcis-Abella</maintainer>
  <license>GPL-2.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
