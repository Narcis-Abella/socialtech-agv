# Experiment image: sim-nav2 plus the spatio-temporal voxel layer (apt, ros-jazzy). Not part of the robot image; used only for the STVL / decay tests.
FROM socialtech:sim-nav2
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ros-jazzy-spatio-temporal-voxel-layer
