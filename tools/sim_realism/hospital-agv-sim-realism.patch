diff --git a/launch/simulation.launch.py b/launch/simulation.launch.py
index 7db4a7d..c0bc685 100644
--- a/launch/simulation.launch.py
+++ b/launch/simulation.launch.py
@@ -85,9 +85,19 @@ def generate_launch_description():
         ),
     )
 
+    # SIM_REALISM=1 (environment): the realism models of socialtech_simreal take over /cmd_vel (base: dead time, lag, in-place deadband), /odom (wheel measurement), /scan (Mid-360 chain noise) and /imu/data (ICM-40609):
+    # Gazebo's acceleration limits are raised, the bridge hands /cmd_vel_gz to the DiffDrive, the legacy noisy_imu / noisy_lidar are not started and noisy_odom (the LiDAR-inertial stand-in, odom -> base_footprint TF)
+    # publishes /odom_lio instead of /odom. Use odom_source:=ground_truth with it. Start socialtech_simreal's sim_realism.launch.py next to this launch.
+    realism = os.environ.get("SIM_REALISM", "0") == "1"
+    # SIM_LIO=1 (with SIM_REALISM=1): a real FAST-LIO2 runs on the simulated Mid-360 (socialtech_livox_sim) and the IMU, so the LiDAR-inertial stand-in (noisy_odom, odom -> base_footprint TF)
+    # is not started (planar_odom publishes that TF), the IMU runs at the Mid-360's 200 Hz and sits where FAST-LIO2 assumes it: the lidar origin minus extrinsic_T (-0.011, -0.02329, 0.04412).
+    lio = realism and os.environ.get("SIM_LIO", "0") == "1"
+    # LIDAR_Z: height of the Mid-360 over the floor. 0.57 is the real robot's (the relocalizer's 17 saved searches put its IMU at 0.52-0.55 m: SocialTech notes/optimizacion_localizacion_2026-11-02.md); the IMU is extrinsic_T below it.
+    lidar_z = float(os.environ.get("LIDAR_Z", "0.57"))
+
     # ── 3. ROBOT DESCRIPTION ──────────────────────────────────────────────────
     doc = xacro.parse(open(xacro_file))
-    xacro.process_doc(doc)
+    xacro.process_doc(doc, mappings={"max_lin_acc": "20.0", "max_ang_acc": "40.0", **({"imu_rate": "200", "imu_xyz": f"0.011 0.02329 {lidar_z - 0.04412:.5f}", "lidar_z": f"{lidar_z}"} if lio else {})} if realism else {})
     robot_description = {"robot_description": doc.toxml(), "use_sim_time": True}
 
     # ── 4. SIMULATION (IGNITION GAZEBO) ───────────────────────────────────────────
@@ -157,6 +167,7 @@ def generate_launch_description():
             # Critical routing: Gazebo -> bridge -> *_raw -> noise node -> final topic
             ("/model/tracer_robot/pose", "/gt/pose"),
             ("/imu", "/imu_raw"),
+            *([("/cmd_vel", "/cmd_vel_gz")] if realism else []),
             ("/odom", "/odom_raw"),
             ("/odom_gt", "/odom_gt_raw"),
             ("/scan", "/scan_raw"),
@@ -213,7 +224,7 @@ def generate_launch_description():
         package="hospital-agv-sim",
         executable="noisy_odom_cpp",
         name="noisy_odom_node",
-        remappings=[("/odom_raw", PythonExpression(["'/odom_gt_raw' if '", LaunchConfiguration("odom_source"), "' == 'ground_truth' else '/odom_raw'"]))],
+        remappings=[("/odom_raw", PythonExpression(["'/odom_gt_raw' if '", LaunchConfiguration("odom_source"), "' == 'ground_truth' else '/odom_raw'"]))] + ([("/odom", "/odom_lio")] if realism else []),
         parameters=[
             {
                 "use_sim_time": True,
@@ -272,9 +283,8 @@ def generate_launch_description():
             spawn_entity,
             bridge,
             image_bridge,
-            noisy_imu_node,
-            noisy_lidar_node,
-            noisy_odom_node,
+            *([] if realism else [noisy_imu_node, noisy_lidar_node]),
+            *([] if lio else [noisy_odom_node]),
             noisy_mid70_node,
             noisy_mid360_node,
         ]
