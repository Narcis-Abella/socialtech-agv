<?xml version="1.0"?>
<package format="3">
  <name>gn_loc</name>
  <version>0.1.0</version>
  <description>map to odom by Gauss-Newton scan-to-map tracking on the occupancy grid distance field with a Kalman prior (2D, no particles)</description>
  <maintainer email="narcis.abellallos@gmail.com">Narcis</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>bondcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
  <depend>rosbag2_cpp</depend>
  <depend>nav2_map_server</depend>
  <depend>tf2_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
