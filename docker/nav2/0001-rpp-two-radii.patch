 void RegulatedPurePursuitController::setPlan(const nav_msgs::msg::Path & path)
 {
-  has_reached_xy_tolerance_ = false;
+  // The planner republishes the path while the robot is still on the same goal. With two radii the latch is a hysteresis (enter at the small radius,
+  // leave at the large one) and has to survive those paths; a new goal, or a new action (no control cycle for 1 s), starts from scratch. With one
+  // radius (upstream behaviour) every path re-evaluates it.
+  bool keep = false;
+  if (hasTwoRadii() && has_reached_xy_tolerance_ && has_latched_goal_ && has_last_cycle_ && !path.poses.empty()) {
+    auto node = node_.lock();
+    const auto & goal = path.poses.back().pose;
+    keep = node && (node->now() - last_cycle_time_).seconds() < 1.0 &&
+      std::hypot(
+      goal.position.x - latched_goal_.position.x,
+      goal.position.y - latched_goal_.position.y) < 0.01 &&
+      std::fabs(
+      angles::shortest_angular_distance(
+        tf2::getYaw(goal.orientation), tf2::getYaw(latched_goal_.orientation))) < 0.01;
+  }
+  if (!keep) {
+    has_reached_xy_tolerance_ = false;
+  }
+  has_latched_goal_ = !path.poses.empty();
+  if (has_latched_goal_) {
+    latched_goal_ = path.poses.back().pose;
+  }
   path_handler_->setPlan(path);
 }
 
