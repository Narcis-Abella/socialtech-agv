#!/bin/bash
# The container half of ops/nav_live.sh: the live stack of the robot (localization, and Nav2 with NAV=1), started by its absolute path (never `ros2 run`: a signal sent to it
# would not reach this script, and the recorder below needs its SIGINT). The host half (ops/nav_live.sh) checks the board, the map and the flags, and passes them here as the
# environment: NAV BASE PROD LEVEL_CORRECTOR HEAVY_DDS SUPERVISOR GYR_COV FILTER_SIZE_MAP POINT_FILTER_NUM DDS_IFACE PEER ROS_DOMAIN_ID LIVOX_HOST_IP LIVOX_LIDAR_IP, the map at /map,
# the run directory at /runs. /ros_env.sh was sourced by the entrypoint (a source here would put /opt/socialtech back in front of an overlay).
set -eo pipefail
HERE=$(cd "$(dirname "$(realpath "$0")")" && pwd)
SHARE=$(ros2 pkg prefix socialtech_bringup)/share/socialtech_bringup
source "$HERE/flags.sh"
source "$HERE/fastlio_config.sh"
source /cyclone_uri.sh
normalize_flags NAV BASE SUPERVISOR PROD LEVEL_CORRECTOR HEAVY_DDS

if [[ -n ${LEVEL_CORRECTOR:-} ]]; then
  ros2 run level_corrector level_corrector_node --ros-args -p map_dir:=/map -p check_only:=true >/tmp/lc_check.log 2>&1 || { echo "FAIL: level_corrector cannot load /map (map.ply: binary little-endian, float x y z only; map.yaml: the four T_map_world rows): $(tail -2 /tmp/lc_check.log | tr '\n' ' ') -- or LEVEL_CORRECTOR=0" >&2; exit 1; }
fi
if [[ -n ${SUPERVISOR:-} ]]; then   # on by default: what it needs is checked here, not found out by a respawn loop
  [[ -f /map/prior/map.xyz ]] || { echo "FAIL: /map/prior/map.xyz (the 3D prior the supervisor relocalizes in) is missing: ops/nav_live.sh builds it for a map that has none; or SUPERVISOR=0" >&2; exit 1; }
  export SUP_PRIOR=/map/prior/map.xyz
  python3 -B - <<'PY' || { echo "FAIL: the supervisor cannot start in this image (see above); SUPERVISOR=0 runs without it" >&2; exit 1; }
import os, sys
import numpy, scipy, rclpy, action_msgs.msg, diagnostic_msgs.msg
from rclpy.experimental import EventsExecutor
dirs = [os.path.join(p, "lib", "gn_supervisor") for p in os.environ.get("AMENT_PREFIX_PATH", "").split(os.pathsep)]
node = next((d for d in dirs if os.path.isfile(os.path.join(d, "gn_supervisor_node.py"))), None)
lib = next((d for d in dirs if os.path.isfile(os.path.join(d, "libcorr_search.so"))), None)
if not node or not lib:
    sys.exit(f"no lib/gn_supervisor with gn_supervisor_node.py and libcorr_search.so on the ament path ({dirs})")
sys.path.insert(0, node)
import gn_supervisor_node, corr_cpp
corr_cpp.load(os.path.join(lib, "libcorr_search.so"))
PY
fi
export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-53}
export CYCLONEDDS_URI=$(stack_cyclone_uri "${DDS_IFACE:-}" "${PEER:-}")   # lo, DDS_IFACE and the laptop (PEER) if there is one: docker/cyclone_uri.sh
set_cyclone_uri   # this export replaced the URI of ros_env.sh: ask again for the 10 MB receive buffer (docker/cyclone_uri.sh)
h=$(python3 -c "import json; print(json.load(open('/map/report.json'))['sensor_height_m'])")
read -r qx qy qz qw < <(python3 "$HERE/map_frame.py" level --ref /map/vs/run/alidarState.txt --map /map/map.yaml)
"$HERE/livox_config.sh" >/tmp/MID360_config.json
fastlio_yaml /tmp/fastlio.yaml
echo "sensor height $h m; level quaternion $qx $qy $qz $qw; DDS ${DDS_IFACE:-lo} -> ${PEER:-no peer} (domain $ROS_DOMAIN_ID)"
launch=nav_live; extra=()
if [[ -n ${NAV:-} ]]; then   # navigation: Nav2 params of the sim + the real robot's differences
  nav=$(ros2 pkg prefix socialtech_nav)/share/socialtech_nav   # the image's, or the overlay's with OVERLAY=1: the simulation reads the package's too
  python3 "$HERE/merge_params.py" "$nav/config/nav2_params.yaml" "$SHARE/config/nav2_robot_overrides.yaml" >/tmp/nav2_params.yaml
  sed -i "s#/opt/socialtech/share/socialtech_nav/#$nav/#" /tmp/nav2_params.yaml   # the behavior tree path is absolute in the file: follow the package that was used
  lc_topics=(); [[ -z ${LEVEL_CORRECTOR:-} ]] || lc_topics=(/level_corrector/status /level_corrector/correction)   # its state per cycle (gate reasons, measured tilt, C) and the correction planar_odom applies
  sup_topics=(); [[ -z ${SUPERVISOR:-} ]] || sup_topics=(/gn_loc/status /gn_loc/scan_fit /gn_loc/need_reloc /gn_supervisor/state /initialpose /navigate_through_poses/_action/status)   # only where they exist
  set -m   # job control: a background job of a non-interactive shell ignores SIGINT, and the recorder needs one to write its metadata.yaml
  python3 "$HERE/nav_start_when_localized.py" &   # lifetime = the container's
  if [[ -z ${PROD:-} ]]; then   # PROD=1: no recording
    # Everything needed to judge a run offline (and to replay FAST-LIO on it: /Odometry, /livox/lidar, /livox/imu): the three speed stages, what the base reports, gn_loc, BT, plans, scan, local costmap, TF, goals. Not the global costmap (static, big).
    ros2 bag record -s mcap -o /runs/bag /cmd_vel_nav /cmd_vel_smoothed /cmd_vel /odom /tracer_status /gn_loc/pose /behavior_tree_log /collision_monitor_state /diagnostics \
      /goal_pose /plan /local_plan /received_global_plan /speed_limit /scan /local_costmap/costmap /tf /tf_static /navigate_to_pose/_action/status /navigate_to_pose/_action/feedback \
      /Odometry /livox/lidar /livox/imu "${sup_topics[@]}" "${lc_topics[@]}" \
      </dev/null >/runs/bag.log 2>&1 &
    rec=$!
  fi
  [[ -z ${BASE:-} ]] || { sleep 12; python3 "$HERE/base_state.py" --require-can || echo "!!! the base IGNORES Nav2's commands until this is fixed" >&2; } &   # tracer_base has asked for CAN mode by then
  launch=nav_robot; extra=(nav2_params:=/tmp/nav2_params.yaml base:=$([[ -n ${BASE:-} ]] && echo true || echo false))
fi
[[ -z ${PROD:-} ]] || extra+=(viz:=false)
[[ -z ${LEVEL_CORRECTOR:-} ]] || extra+=(level_corrector:=true)
args=(socialtech_bringup "$launch.launch.py" livox_config:=/tmp/MID360_config.json fastlio_params:=/tmp/fastlio.yaml map:=/map/map.yaml
  sensor_height:="$h" level_qx:="$qx" level_qy:="$qy" level_qz:="$qz" level_qw:="$qw" "${extra[@]}")
[[ -n ${NAV:-} && -z ${PROD:-} ]] || exec ros2 launch "${args[@]}"   # no recorder (PROD, or no NAV): nothing to stop after the launch
# With the recorder running (DEV) the launch is a child, not exec'd: when it ends (Ctrl-C reaches this script through tini and is forwarded) the recorder gets
# its SIGINT and finishes the bag. Exec'd, nobody stopped it and the bag stayed without metadata.yaml (29-31 Oct runs).
ros2 launch "${args[@]}" &
lp=$!
rc=0
trap 'kill -INT "$lp" 2>/dev/null || true' INT TERM HUP   # HUP: the ssh session died; without it the script (and tini) died at once and every node was SIGKILLed with the bag unfinished
while kill -0 "$lp" 2>/dev/null; do wait "$lp" || rc=$?; done
kill -INT "$rec" 2>/dev/null || true
wait "$rec" || true
exit "$rc"
