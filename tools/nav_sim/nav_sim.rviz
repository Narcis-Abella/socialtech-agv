Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map (PGM)
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 0; 120; 255
      Line Style: Lines
      Line Width: 0.05
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
    - Class: rviz_default_plugins/Path
      Name: Local plan (RPP)
      Enabled: true
      Color: 0; 220; 0
      Line Style: Lines
      Line Width: 0.04
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Color: 255; 0; 0
      Style: Flat Squares
      Size (m): 0.05
      Decay Time: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/Marker
      Name: Legend (job and trial)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /legend
    - Class: rviz_default_plugins/MarkerArray
      Name: Speed guard (lane, limit)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /speed_guard/markers
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 255; 255; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: true
      Color: 255; 25; 0
      Covariance:
        Position:
          Alpha: 0.4
          Color: 255; 25; 0
          Scale: 1
          Value: true
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Scale: 1
          Value: true
        Value: true
      Head Length: 0.3
      Head Radius: 0.12
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amcl_pose
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Marker Scale: 1
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 18
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 5
      Y: 15
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1500
